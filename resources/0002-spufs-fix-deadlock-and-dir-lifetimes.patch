+	if (ret < 0 && gang)
 		gang->alive--; // can't reach 0
 	return ret;
 }
@@ -493,7 +496,7 @@
 
 static int spufs_gang_close(struct inode *inode, struct file *file)
 {
-	unuse_gang(file->f_path.dentry);
