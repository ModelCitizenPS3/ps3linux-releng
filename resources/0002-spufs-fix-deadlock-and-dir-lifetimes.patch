diff -Naur a/arch/powerpc/platforms/cell/spufs/inode.c b/arch/powerpc/platforms/cell/spufs/inode.c
--- a/arch/powerpc/platforms/cell/spufs/inode.c	2026-09-14 07:36:19.000000000 -0400
+++ b/arch/powerpc/platforms/cell/spufs/inode.c	2026-09-17 07:42:27.213908025 -0400
@@ -172,7 +172,7 @@
 	return 0;
 }
 
-static void unuse_gang(struct dentry *dir)
+static void unuse_gang(struct dentry *dir, bool parent_locked)
 {
 	struct inode *inode = dir->d_inode;
 	struct spu_gang *gang = SPUFS_I(inode)->i_gang;
@@ -183,9 +183,12 @@
 		inode_lock(inode); // exclusion with spufs_create_context()
 		dead = !--gang->alive;
